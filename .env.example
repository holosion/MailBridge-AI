# ---- Core (required) ----
# Local PostgreSQL for development; swap for a hosted URL later.
DATABASE_URL="postgresql://mailbridge:mailbridge@localhost:5432/mailbridge?schema=public"
# Public base URL of the web app (used for OAuth redirect URIs and same-origin checks).
APP_URL="http://localhost:3000"
# >=32 random chars. Signs sessions (Better Auth) and Gmail OAuth state. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# Key ring for encrypting provider tokens at rest (AES-256-GCM). Format: "<version>:<base64 32-byte key>[,<version>:<key>...]"
# Generate one key: openssl rand -base64 32     Example value: "1:AbC...=="
ENCRYPTION_KEYS=""
# Which key version encrypts NEW data. Old versions stay in ENCRYPTION_KEYS so existing data stays readable.
ENCRYPTION_KEY_CURRENT="1"

# ---- Demo mode ----
# true = synthetic emails, mock AI, mock WhatsApp. Nothing leaves the machine. Everything is labelled DEMO in the UI.
DEMO_MODE="true"
# Dev only: lets the owner mark a WhatsApp number verified without an inbound message (e.g. Meta test number).
ALLOW_OWNER_ATTEST="false"

# ---- Google (Gmail connect + optional Google sign-in) ----
# Create an OAuth client (Web). Add BOTH redirect URIs:
#   {APP_URL}/api/gmail/callback        (Gmail connect)
#   {APP_URL}/api/auth/callback/google  (Google sign-in, optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- AI provider ----  mock | anthropic
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
# Verify the model id against current Anthropic docs before live use.
ANTHROPIC_MODEL="claude-haiku-5-5"

# ---- WhatsApp Business Platform (Cloud API) ----  mock | cloud
WHATSAPP_PROVIDER="mock"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Verify the current Graph API version in Meta docs; versions expire.
WHATSAPP_API_VERSION="v23.0"
# Meta App Secret: used ONLY to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=""
# Any random string you also enter in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=""
# Pre-approved template names. hello_world exists on new test setups; mail_summary is YOURS to create/approve (see docs/ARCHITECTURE.md).
WHATSAPP_TEMPLATE_TEST="hello_world"
WHATSAPP_TEMPLATE_SUMMARY=""
WHATSAPP_TEMPLATE_LANG="en_US"
# Explicit authorization list (E.164, comma separated). The cloud provider REFUSES to send to any number not listed.
WHATSAPP_LIVE_SEND_ALLOWLIST=""

# ---- Limits / retention ----
MONTHLY_SUMMARY_LIMIT="200"
MONTHLY_NOTIFICATION_LIMIT="100"
RETENTION_BODY_DAYS="7"
RETENTION_EMAIL_DAYS="90"
RETENTION_HISTORY_DAYS="180"
